__pycache__/
*.pyc
*.png
*.pdf
*.out
*.csv
demo_output/
test_opt_output/
test_pp_output/
.coverage
coverage.xml
htmlcov/

venv/
*.egg-info/
dist/

# Data files are tracked (CSV is ignored elsewhere)
!data/**/*.csv
!examples/*/data/*.csv

# Example run outputs are regenerated, never committed; only the figures an
# example's README shows are kept (examples/<name>/figures/)
examples/*/output/
!examples/*/figures/*.png

# Validation evidence: the report's figures and summary tables are committed
validation/work/
!validation/figures/*.png
!validation/results/*.csv
